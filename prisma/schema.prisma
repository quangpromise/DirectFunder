generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Giai đoạn 1 của kế hoạch backend hoá (xem .claude/rules/deployment-database-sync.md):
/// chỉ Users + Auth + Cases (kèm Orders/DescriptionReplies dạng JSON nhúng trong Case
/// cho đơn giản, sẽ tách bảng riêng ở giai đoạn sau nếu cần). Notifications, audit log,
/// deletion history vẫn tạm ở Zustand/localStorage, chưa migrate.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  /// Tên đăng nhập thay thế cho email (không bắt buộc) — Admin đặt trong trang Quản lý tài
  /// khoản. Đăng nhập chấp nhận CẢ email lẫn username (xem POST /api/auth/login), lưu
  /// lowercase giống email để so khớp không phân biệt hoa/thường.
  username     String?  @unique
  passwordHash String
  role         String
  avatarColor  String
  avatarUrl    String?
  /// Chỉ có ý nghĩa với role agent_leader/processor_leader — id các Agent/Processor mà
  /// leader này được xem hồ sơ. Admin gán qua trang Quản lý tài khoản.
  teamMemberIds String[] @default([])
  /// Refresh token OAuth2 Google Sheets (tính năng "Send" đẩy dòng hồ sơ lên Google
  /// Sheet) — null = user chưa kết nối tài khoản Google. Chỉ lưu refresh_token, access
  /// token luôn xin mới qua refresh_token mỗi lần gọi API (xem src/lib/google-sheets.ts),
  /// không lưu/đồng bộ access_token + hạn dùng riêng cho đơn giản.
  googleRefreshToken String?
  /// Email webmail (mail.directfunder.com, SMTP thường qua nodemailer) mà user tự kết nối
  /// cho tính năng "Gửi email cho khách hàng" — null = chưa kết nối. Thay cho
  /// microsoftRefreshToken/OAuth2 Microsoft Graph cũ (đã gỡ bỏ vì không có quyền admin
  /// Azure AD của tenant công ty để tạo App registration, xem
  /// .claude/rules/deployment-database-sync.md). Có thể khác email đăng nhập app.
  webmailUsername String?
  /// Mật khẩu webmail của webmailUsername, mã hóa 2 chiều bằng src/lib/webmail-crypto.ts
  /// (AES-256-GCM) — KHÔNG lưu plain text vì đây là mật khẩu thật không thể thu hồi từ xa
  /// như OAuth refresh token (khác googleRefreshToken ở trên).
  webmailPasswordEncrypted String?
  /// Nội dung "My Notes" (thêm 2026-08-23) — ghi chú cá nhân, HTML rich text (đậm/nghiêng/
  /// gạch ngang/màu chữ/màu nền, xem src/components/my-notes-editor.tsx +
  /// sanitizeNotesHtml trong src/lib/rich-text.ts). CHỈ chính chủ tài khoản đọc/sửa được
  /// (GET/PATCH /api/me/notes) — KHÔNG bao giờ trả về trong GET /api/users (danh sách dùng
  /// chung cho mọi user xem để gán việc), tránh lộ ghi chú riêng tư cho người khác.
  myNotesHtml String?
  /// Cho phép user này xem panel "Đang online" ở top-nav (chấm xanh/xám theo từng tài
  /// khoản, thêm 2026-08-23) dù KHÔNG phải Manager — Admin bật/tắt riêng từng tài khoản qua
  /// trang Quản lý tài khoản (nút mắt trên UserCard). Manager luôn xem được bất kể cờ này
  /// (hasFeature-style bypass, xem OnlineUsersButton). Mặc định false — không đổi hành vi
  /// hiện có (trước đây chỉ Manager xem được qua trang /dashboard/users).
  canViewOnlinePresence Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Case {
  id                 String   @id @default(cuid())
  status             String
  /// [ClientNameEntry, ClientNameEntry] — { firstName, lastName }
  clients            Json
  clientLink         String?
  zipcode            String
  phone              String
  /// Số điện thoại phụ — chỉ sửa được qua popup "Edit Hồ sơ" (client-profile-dialog),
  /// không hiển thị như 1 cột riêng trong bảng Hồ sơ.
  phone2             String   @default("")
  /// Email liên hệ — chỉ sửa được qua popup "Edit Hồ sơ", tương tự phone2.
  email              String   @default("")
  /// [string | null, string | null] — ngày sinh ISO "YYYY-MM-DD" của 2 khách hàng, cùng
  /// thứ tự với `clients`/`ssn`. null = chưa nhập. Chỉ sửa qua popup "Edit Hồ sơ".
  dateOfBirth        Json?
  address            String
  description        String
  /// DescriptionReply[]
  descriptionReplies Json     @default("[]")
  descriptionReadBy  String[] @default([])
  caseNumber         String   @unique
  /// Tổng tiền hoàn thuế — LUÔN được server tự tính = tổng các giá trị trong `refunds`
  /// mỗi khi popup "Edit Hồ sơ" lưu (xem POST /api/cases/[id]/client-profile), không
  /// còn nhận sửa trực tiếp qua PATCH thường (cột "money" có editableBy rỗng — xem
  /// DEFAULT_COLUMNS trong rbac.ts).
  money              Float
  /// Record<string, number> — key năm dạng "2022".."2025", value = số tiền hoàn thuế
  /// năm đó (0 = chưa nhập). money = tổng mọi giá trị trong đây, tự tính ở server mỗi
  /// lần popup "Edit Hồ sơ" lưu. Xem src/lib/refund.ts.
  refunds            Json     @default("{}")
  /// OrderRecord[]
  orders             Json     @default("[]")
  /// [string | null, string | null]
  ssn                Json
  assignedTo         String?
  assignedProcessor  String?
  /// Slot Agent/Processor thứ 2 — cùng chức năng/quyền hệt assignedTo/assignedProcessor
  /// (thêm 2026-08-12, xem AssignMenu thứ 2 trong cases/page.tsx), chỉ khác không tự động
  /// gán cho người tạo hồ sơ (addRow chỉ tự gán slot 1, slot 2 luôn bắt đầu trống).
  assignedTo2        String?
  assignedProcessor2 String?
  /// Id người tạo hồ sơ — dùng cho Agent Leader/Processor Leader tự sửa hồ sơ do mình
  /// thêm vào dù chưa gán cho ai trong nhóm.
  createdBy          String?
  /// Giá trị các cột tuỳ chỉnh (custom columns)
  custom             Json     @default("{}")
  /// Record<năm, "processing"|"pending"|"cpaReview"> — trạng thái xử lý riêng cho từng
  /// năm refund, chọn qua popup nút mắt cạnh cột "Case" (xem CaseRefundStatusButton).
  /// Năm có refund > 0 nhưng chưa có key ở đây mặc định coi là "processing" (xem
  /// DEFAULT_REFUND_YEAR_STATUS trong src/lib/refund-status.ts).
  refundYearStatus   Json     @default("{}")
  /// Record<năm, string> — lý do Pending nhập tay, chỉ có ý nghĩa khi năm đó đang ở trạng
  /// thái "pending" (refundYearStatus). KHÔNG giới hạn quyền sửa theo role như
  /// refundYearStatus — mọi user đăng nhập đều sửa được (xem PATCH /api/cases/[id], field
  /// này không map qua FIELD_TO_COLUMN_KEY nên không bị chặn theo editableBy).
  refundYearPendingReason Json @default("{}")
  /// Record<năm, string | null> — ngày E-file ISO "YYYY-MM-DD" riêng cho từng năm refund,
  /// cạnh refundYearStatus — dùng cho đồng bộ 2 chiều "CPA Review" với Google Sheet (xem
  /// deployment-database-sync.md mục 4.22), sửa qua popup "Refund by years" giống
  /// refundYearStatus.
  refundYearEfileDate Json @default("{}")
  /// Record<năm, { date: string "YYYY-MM-DD"; userId: string; notifiedAt: string | null }> —
  /// lịch nhắc kiểm tra TTS & WIT riêng từng năm, đặt qua icon đồng hồ cạnh Status trong
  /// popup "Refund by years" (CaseRefundStatusButton). Cron hằng ngày (xem
  /// src/lib/refund-alarm.ts, piggyback trên cron/ringcentral-renew để không vượt giới hạn
  /// số Cron Job của gói Hobby) quét mọi hồ sơ, tạo Notification cho `userId` khi `date` <=
  /// hôm nay (giờ Phoenix) và `notifiedAt` còn null, rồi set notifiedAt để không lặp lại.
  /// Đặt lại `date` (sửa lịch) luôn kèm notifiedAt: null để có thể bắn lại. Không giới hạn
  /// quyền sửa theo role (giống refundYearPendingReason) — field này không map qua
  /// FIELD_TO_COLUMN_KEY trong PATCH /api/cases/[id].
  refundYearAlarm Json @default("{}")
  /// Ngày ISO "YYYY-MM-DD" (hiển thị mm/dd/yy) — 3 field mới, chỉ sửa qua popup "Edit Hồ
  /// sơ" (client-profile-dialog), đặt ngang hàng ngay dưới khối Refund. null = chưa nhập.
  fcDate             String?
  processingDate     String?
  elDate             String?
  /// 3 ô nhập tay riêng cho email "Thông báo hoàn thuế" gửi khách hàng (nút gửi mail cạnh
  /// ô Email, xem POST /api/cases/[id]/send-client-email) — chỉ sửa qua popup "Edit Hồ sơ",
  /// đặt ngay dưới khối 3 ô ngày FC/Processing/EL Date ở trên. Không dùng cho mục đích nào
  /// khác trong hệ thống (không phải bank account thật của công ty).
  bankName           String?
  routingNumber      String?
  accountNumber      String?
  /// Ghi chú tự do, đặt ngay dưới 2 khối Taxpayer/Spouse trong popup "Edit Hồ sơ" (lấp
  /// khoảng trống trước đây) — chỉ sửa qua popup này, không hiển thị cột riêng ngoài bảng
  /// Hồ sơ chính, không liên quan cột "Description" (Mô tả) đã có sẵn ngoài bảng.
  note               String?
  /// 2 ô "Accountant"/"Accountant Support", chỉ sửa qua popup "Edit Hồ sơ" giống các field
  /// trên. accountantSupport được tự động đổ vào cột "ACCT" của tab Collecting mỗi khi bấm
  /// "Send Collecting Report" (xem POST /api/cases/[id]/send-collecting-report).
  accountant         String?
  accountantSupport  String?
  /// Record<năm, string> — số tiền "Additional tax on 1099-INT" nhập tay riêng cho từng năm
  /// mỗi khi gửi email "Thông báo hoàn thuế" (popup chọn năm cạnh nút gửi mail) — lưu lại
  /// để lần gửi/gửi lại sau không phải gõ lại, sửa qua chính popup đó (không qua "Edit Hồ
  /// sơ"). Estimated refund = refunds[year] - taxIntByYear[year] hiển thị trong mail.
  taxIntByYear       Json     @default("{}")
  /// Thời điểm gần nhất đã "Send row to Google Sheet" (gửi thật hoặc bấm "Mark as sent"
  /// đánh dấu thủ công) — null = chưa gửi/đã bấm "muốn gửi lại". Lưu xuống DB (không chỉ
  /// React state) để nút Send giữ đúng trạng thái xanh (đã gửi) qua reload/deploy lại,
  /// xem POST /api/cases/[id]/send-to-sheet.
  sheetSentAt        DateTime?
  /// Tương tự sheetSentAt nhưng cho nút "Send mail to CPA" — xem
  /// POST /api/cases/[id]/send-cpa-email.
  cpaEmailSentAt     DateTime?
  /// Tương tự sheetSentAt/cpaEmailSentAt nhưng cho nút "Test Sheet" (gửi hồ sơ sang tab
  /// "CPA Review") — xem POST /api/cases/[id]/test-cpa-review-sheet.
  cpaReviewTestSentAt DateTime?
  /// Tương tự sheetSentAt/cpaEmailSentAt/cpaReviewTestSentAt nhưng cho nút "Send email to
  /// client" (email "Thông báo hoàn thuế") — thêm 2026-08-16 khi đổi từ trạng thái tạm 5s
  /// (useSuccessFlash) sang bền vững qua reload, cùng cơ chế Mark as sent/"muốn gửi lại" —
  /// xem POST /api/cases/[id]/send-client-email.
  clientEmailSentAt  DateTime?
  /// Thứ tự hiển thị dòng trên bảng Hồ sơ (kéo-thả) — số càng nhỏ hiển thị càng lên trên.
  /// Dùng fractional indexing (giá trị mới = trung bình 2 hàng xóm khi kéo-thả) để không
  /// phải ghi lại toàn bộ bảng mỗi lần đổi vị trí 1 dòng. Hồ sơ mới luôn nhận giá trị âm
  /// theo epoch-ms hiện tại (-Date.now()) nên tự động lên đầu, giữ đúng hành vi "mới nhất
  /// lên đầu" đã có trước khi field này tồn tại (xem migration backfill dữ liệu cũ).
  sortOrder          Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("cases")
}

/// Bảng cấu hình dạng singleton (luôn chỉ 1 dòng, id cố định "singleton") — lưu cấu
/// hình cột (ColumnDef[]) và ma trận phân quyền tính năng (FeaturePermissions), tương
/// đương state.columns / state.featurePermissions trong Zustand store hiện tại.
model AppConfig {
  id                 String   @id @default("singleton")
  /// ColumnDef[]
  columns            Json
  /// FeaturePermissions
  featurePermissions Json
  /// CpaEmailDefaults ({ to: string[]; cc: string[] }) — null = Admin chưa cấu hình.
  cpaEmailDefaults   Json?
  /// GoogleSheetConfig ({ sheetId: string; columnIds: string[] }) — Sheet đích + cột nào/
  /// thứ tự nào được đẩy vào dòng mới khi bấm nút "Send" ở cột Status. null = Admin chưa
  /// cấu hình.
  googleSheetConfig  Json?
  /// ClientEmailTemplate ({ cc?, signatureJobTitle?, signaturePhone?, signatureAddress?,
  /// supportPhone? }) — phần Admin cấu hình được cho email "Thông báo hoàn thuế" gửi khách
  /// hàng (nút gửi mail cạnh ô Email popup Edit Hồ sơ). Subject/Body KHÔNG còn là template
  /// tự do (đổi 2026-08-16) — nội dung tính hoàn toàn từ dữ liệu hồ sơ + năm/Tax INT chọn
  /// trong popup gửi, xem src/lib/refund-notification-email.ts. null/thiếu field = dùng
  /// default tương ứng trong src/lib/client-email-template.ts.
  clientEmailTemplate Json?
  /// SelectOption[] — danh sách trạng thái tuỳ chỉnh cho popup "Refund by years" (nút mắt
  /// cạnh cột Case, CaseRefundStatusButton). Quản lý thêm/sửa/xoá qua UI, xem
  /// DEFAULT_REFUND_YEAR_STATUS_OPTIONS trong rbac.ts cho giá trị mặc định khi null/thiếu.
  /// Option id "pending" là id đặc biệt gắn với logic nhấp nháy đỏ + ô nhập lý do
  /// (hasPendingRefundYear) — không thể xoá qua UI dù đổi tên/màu tự do.
  refundYearStatusOptions Json?
  /// ColumnDef[] — cấu hình cột riêng cho tab "Collecting" (bảng thu hồi công nợ, tách
  /// hoàn toàn khỏi bảng Hồ sơ) — cùng cơ chế thêm/sửa/xoá cột qua ColumnSettingsDialog
  /// với `columns` ở trên, chỉ khác đối tượng áp dụng. null/thiếu = dùng
  /// DEFAULT_COLLECTING_COLUMNS trong rbac.ts.
  collectingColumns  Json?
  /// Record<monthKey ("YYYY-MM"), CpaReviewSheetConfig> — MỖI THÁNG 1 Sheet/kết nối riêng
  /// (thêm 2026-08-14, trước đó là 1 object singleton dùng chung mọi tháng). CpaReviewSheetConfig:
  /// { sheetId, gid, tabName, rowIndex: Record<ssn, số dòng>, webhookSecret,
  /// nameToUserId: Record<tên trong Sheet, User.id>, connectedAt, connectedByUserId }. Xem
  /// deployment-database-sync.md mục 4.22. null/thiếu key = tháng đó Admin chưa kết nối.
  cpaReviewSheetConfig Json?
  /// SelectOption[] — danh sách trạng thái (Status) tuỳ chỉnh cho tab "CPA Review" (mỗi khối
  /// năm), Admin thêm/sửa/xoá + đổi màu tự do qua UI (cùng pattern refundYearStatusOptions ở
  /// trên) — null/thiếu = dùng CPA_REVIEW_STATUS_OPTIONS mặc định trong cpa-review-columns.ts.
  cpaReviewStatusOptions Json?
  /// string[] — key các cột "đuôi" (Note/Processor/Agent/CRM Source/FC Date/Processing
  /// Date/EL Date) bị Admin/người có quyền manageCpaReviewSheet ẨN khỏi bảng cho MỌI user
  /// (thêm 2026-08-15, yêu cầu "ẩn hiện cột ở tất cả màn hình có table") — CPA Review cột cố
  /// định (không có ColumnDef riêng như Cases/Collecting) nên dùng list key thay vì field
  /// `hiddenFromGrid` trên từng cột. null/thiếu = không ẩn cột nào.
  cpaReviewHiddenColumns Json?
  /// ProcessorReportTaskDef[] — danh sách "task" (hàng) của bảng Report trong popup "For
  /// Processor" (nút cạnh EC Qualification trên bảng Hồ sơ) — Processor Leader/Quản lý tự
  /// thêm/sửa/xoá qua UI (gate bằng feature manageProcessorReportTasks). Mỗi phần tử:
  /// { id, sectionId, sectionLabel, sectionOrder, label, order }. null/thiếu = dùng
  /// DEFAULT_PROCESSOR_REPORT_TASKS trong rbac.ts (transcribe từ Processor.png/processor
  /// Leader.png, 6 nhóm việc).
  processorReportTasks Json?
  /// Record<monthKey ("YYYY-MM"), ProcessorReportSheetConfig> — đồng bộ 2 chiều Google Sheet
  /// cho bảng tổng hợp Processor Leader, mỗi tháng 1 kết nối riêng (cùng tinh thần
  /// cpaReviewSheetConfig). ProcessorReportSheetConfig: { sheetId, gid, tabName,
  /// taskRowMap: Record<taskId, số dòng>, userColumnMap: Record<userId, số cột 0-based>,
  /// webhookSecret, connectedAt, connectedByUserId }. Khác CPA Review: hàng/cột đều biết
  /// trước từ processorReportTasks + danh sách user role processor, không cần quét-tìm-dòng.
  processorReportSheetConfig Json?
  /// ID subscription webhook RingCentral hiện tại (nhận SMS đến real-time) — null = chưa
  /// tạo/đã hết hạn. Subscription RingCentral chỉ sống tối đa ~7 ngày, cần tự gia hạn định
  /// kỳ (xem src/lib/ringcentral.ts renewRingCentralSubscription).
  ringcentralSubscriptionId String?
  /// Thời điểm subscription trên hết hạn (ISO, RingCentral trả về lúc tạo/gia hạn) — dùng
  /// để tự biết khi nào cần gọi renew trước khi hết hạn.
  ringcentralSubscriptionExpiresAt DateTime?
  /// string[] — danh sách loại thư IRS được coi là "gửi qua văn phòng" (hasCareOf / hậu tố
  /// " Not Update CRM") trong tab "Notice Splitter" (popup "For Processor") — Quản lý thêm/
  /// xoá qua UI (NoticeSplitterCareOfManager). null/thiếu = dùng
  /// DEFAULT_CARE_OF_ELIGIBLE_NOTICE_TYPES trong src/lib/irs-splitter/care-of-eligibility.ts.
  careOfEligibleNoticeTypes Json?
  /// Session cookie (`ci_session`) hiện tại của tài khoản CRM agentc3 dùng chung (đăng nhập
  /// qua AGENTC3_USERNAME/PASSWORD) — thêm 2026-08-28 vì cache module-scope thuần trong
  /// `agentc3-client.ts` KHÔNG dùng chung được giữa các route Next.js khác nhau (mỗi route
  /// là 1 Serverless Function riêng trên Vercel, module state tách biệt) — vd bấm nút "Check
  /// log" (route check-latest-tts, tự đăng nhập) rồi mở chat so sánh WIT/TTS (route
  /// compare-tts-wit-chat) vẫn phải đăng nhập lại dù vừa đăng nhập xong vài giây trước. Lưu
  /// xuống đây để MỌI route đọc lại được, chỉ tự đăng nhập khi cột này trống/hết hạn (so
  /// SESSION_TTL_MS trong agentc3-client.ts). Không nhạy cảm bằng mật khẩu thật — chỉ là
  /// token phiên tạm của 1 tài khoản chức năng dùng chung, không phải secret theo từng user.
  agentc3SessionCookie String?
  /// Thời điểm cookie trên được lưu (dùng so với SESSION_TTL_MS để biết còn hạn dùng hay
  /// phải đăng nhập lại).
  agentc3SessionCookieAt DateTime?
  updatedAt          DateTime @updatedAt

  @@map("app_config")
}

/// Bảng tin "Rules" (tab điều hướng riêng, sau Orders) — Quản lý thêm/sửa/xoá thông báo
/// quy định nội bộ. Xoá KHÔNG xoá hẳn (soft-delete qua deletedAt/deletedBy) — rule bị xoá
/// vẫn hiện trong danh sách, bị đẩy xuống cuối + gạch ngang chữ (xem GET /api/rules cho
/// thứ tự sắp xếp, src/components/rule-card.tsx cho UI gạch ngang).
/// Log 1 dòng MỖI lần gọi Gemini thành công (thêm 2026-08-26) — dùng để tính bảng "Rate Limit"
/// (RPM/TPM/RPD so với hạn mức free tier) hiện trong popup "Get Files" (so sánh WIT/TTS AI).
/// Chỉ 2 field tối thiểu — không cần lưu nội dung request/response, chỉ cần đủ để tính tổng
/// theo cửa sổ thời gian. Dọn định kỳ (piggyback cron/blob-cleanup, xem gemini-usage.ts) vì
/// chỉ cần giữ dữ liệu trong ~1 ngày (RPD) là đủ, không cần lưu mãi mãi.
model GeminiUsageLog {
  id          String   @id @default(cuid())
  requestedAt DateTime @default(now())
  totalTokens Int

  @@index([requestedAt])
  @@map("gemini_usage_logs")
}

model Rule {
  id        String    @id @default(cuid())
  content   String
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  @@map("rules")
}

/// Bảng "Collecting" (tab điều hướng riêng, sau Orders) — bảng dữ liệu kiểu Excel giống
/// bảng Hồ sơ nhưng độc lập hoàn toàn (khách hàng/case riêng, không liên kết tới Case).
/// Mọi giá trị cột lưu chung trong `custom` (JSON, key = ColumnDef.key) — KHÔNG có field
/// cố định nào khác giống Case (status/clients/...) vì cột ở tab này hoàn toàn cấu hình
/// được qua AppConfig.collectingColumns, chưa có hành vi đặc biệt riêng cột nào (tính
/// năng cụ thể sẽ bổ sung sau, hiện tại chỉ là khung bảng + inline edit).
model CollectingRecord {
  id        String   @id @default(cuid())
  custom    Json     @default("{}")
  sortOrder Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("collecting_records")
}

/// Bảng "CPA Review" (tab điều hướng riêng, sau Collecting) — bảng dữ liệu kiểu Excel khớp
/// đúng cấu trúc cột A-AH của 1 Google Sheet tháng thật đã khảo sát, đồng bộ 2 chiều qua
/// Service Account (xem deployment-database-sync.md mục 4.22). ĐỘC LẬP HOÀN TOÀN với Case
/// (theo yêu cầu user 2026-08-14: "không liên kết bất cứ gì") — cùng nguyên tắc với
/// CollectingRecord ở trên: mọi giá trị cột lưu chung trong `custom` (JSON, key cố định
/// khớp cpa-review-columns.ts, KHÔNG cấu hình được qua UI như Collecting vì cột phải khớp
/// đúng Sheet). SSN (custom.ssn) là khoá đối chiếu 2 chiều với Sheet — CHỈ DUY NHẤT trong
/// CÙNG 1 `month` (thêm 2026-08-14), không còn duy nhất toàn bảng vì mỗi tháng là 1 bảng
/// dữ liệu độc lập (khách quay lại tháng sau vẫn cùng SSN nhưng là 1 dòng mới).
model CpaReviewRecord {
  id        String   @id @default(cuid())
  /// "YYYY-MM" — tháng dữ liệu này thuộc về (chọn qua bộ chọn tháng trên UI). Quyết định
  /// dòng này hiện trong bảng của tháng nào VÀ đồng bộ với đúng cấu hình Sheet nào trong
  /// AppConfig.cpaReviewSheetConfig[month].
  month     String
  custom    Json     @default("{}")
  sortOrder Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([month])
  @@map("cpa_review_records")
}

/// Thông báo trong app (chuông) — trước đây được tạo hoàn toàn ở client (Zustand `set()`),
/// không có bảng DB nào, nên người được giao việc (toUserId) không bao giờ thực sự nhận
/// được thông báo trên máy của họ (chỉ tồn tại trong trình duyệt người thao tác). Giờ tạo
/// server-side (xem PATCH /api/cases/[id]) + đẩy realtime qua Pusher (src/lib/pusher-server.ts,
/// kênh `private-notifications-{toUserId}`).
model Notification {
  id         String   @id @default(cuid())
  /// "assigned" | "status_change" | "mention"
  type       String
  toUserId   String
  fromUserId String
  caseId     String
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([toUserId, createdAt])
  @@map("notifications")
}

/// Lịch sử chỉnh sửa 1 ô dữ liệu (mọi cột) — trước 2026-08-13 chỉ tồn tại client-side
/// (Zustand persist, xem comment đầu file), mỗi trình duyệt chỉ thấy thay đổi do CHÍNH nó
/// thực hiện. Giờ ghi lên server để MỌI user đăng nhập đều xem được toàn bộ lịch sử (không
/// giới hạn chỉ xem thay đổi của chính mình) — xem GET/POST /api/history/edits.
model EditHistoryEntry {
  id             String   @id @default(cuid())
  caseId         String
  /// SSN đại diện tại thời điểm sửa (primarySsn) — null nếu hồ sơ chưa có SSN nào.
  ssn            String?
  clientName     String
  fieldLabel     String
  oldValue       String
  newValue       String
  editedByUserId String
  editedAt       DateTime @default(now())

  @@index([editedAt])
  @@map("edit_history_entries")
}

/// Lịch sử xoá hồ sơ — cùng lý do/thời điểm chuyển sang server với EditHistoryEntry ở trên.
model DeletedRowEntry {
  id              String   @id @default(cuid())
  /// Snapshot đầy đủ CaseRecord tại thời điểm xoá (JSON, giữ nguyên định dạng client).
  caseSnapshot    Json
  deletedByUserId String
  deletedAt       DateTime @default(now())

  @@index([deletedAt])
  @@map("deleted_row_entries")
}

/// Số liệu THẬT do từng Processor tự nhập hằng ngày trong popup "For Processor" (tab
/// Report) — 1 dòng = 1 (user, task, ngày). taskId tham chiếu AppConfig.processorReportTasks
/// (hoặc DEFAULT_PROCESSOR_REPORT_TASKS nếu chưa cấu hình) — KHÔNG có FK cứng vì task có thể
/// bị xoá/đổi id, dữ liệu cũ mồ côi vẫn an toàn (giống cách CollectingRecord.custom tham
/// chiếu ColumnDef.key). Đây là bảng nguồn cho bảng cá nhân của Processor; bảng tổng hợp của
/// Processor Leader đọc qua cache ProcessorReportMonthlySummary bên dưới, không tính trực
/// tiếp từ bảng này mỗi lần xem.
model ProcessorReportEntry {
  id        String   @id @default(cuid())
  userId    String
  taskId    String
  /// "YYYY-MM-DD"
  date      String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, taskId, date])
  @@index([userId, date])
  @@map("processor_report_entries")
}

/// Cache tổng theo (tháng, task, user) — tính lại đúng 1 ô mỗi khi 1 ProcessorReportEntry
/// thay đổi (xem after() trong POST/PATCH /api/processor-report/entries), dùng để: (1) hiển
/// thị nhanh bảng tổng hợp Processor Leader (đọc cache, không JOIN/SUM lại mỗi request), (2)
/// làm nguồn đồng bộ 2 chiều Google Sheet (xem processor-report-sheet-sync.ts). LƯU Ý ngữ
/// nghĩa: đây là số liệu TÍNH RA (không phải bản ghi gốc) — sửa tay 1 ô trên Sheet có hiệu
/// lực ngay (webhook ghi đè `value`) nhưng sẽ bị TÍNH LẠI đè lên ngay khi chính Processor đó
/// sửa thêm 1 entry của đúng task/tháng này, khác CPA Review (nơi Sheet giữ đúng bản ghi gốc).
model ProcessorReportMonthlySummary {
  id        String   @id @default(cuid())
  /// "YYYY-MM"
  month     String
  taskId    String
  userId    String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([month, taskId, userId])
  @@index([month])
  @@map("processor_report_monthly_summaries")
}

/// Tin nhắn SMS gửi/nhận qua RingCentral (1 số điện thoại công ty dùng chung cho mọi user,
/// xem src/lib/ringcentral.ts) — KHÔNG liên kết Case bằng foreign key, mà khớp theo
/// `counterpartNumber` (E.164, xem src/lib/phone.ts) với Case.phone/phone2 mỗi lần đọc —
/// cùng tinh thần "bảng độc lập" như CollectingRecord/CpaReviewRecord, tránh 1 số điện thoại
/// gắn cứng vào đúng 1 case nếu sau này SSN/case đổi nhưng số điện thoại thật của khách vẫn
/// vậy. `direction`: "in" (khách nhắn tới) | "out" (user gửi đi). `readAt` chỉ có ý nghĩa với
/// tin nhắn "in" — null = chưa đọc, dùng để tính icon đỏ trên bảng Hồ sơ (xem GET /api/cases,
/// field tính toán `hasUnreadSms` trên CaseRecord — KHÔNG lưu cột riêng trên Case).
model SmsMessage {
  id                   String    @id @default(cuid())
  direction            String
  /// Số điện thoại đối phương, chuẩn hoá E.164 (vd "+14807168858").
  counterpartNumber    String
  text                 String
  /// ID tin nhắn bên RingCentral — dùng để chống trùng khi webhook gửi lại (tối đa 1 lần
  /// nhưng RingCentral khuyến cáo xử lý idempotent).
  ringcentralMessageId String?   @unique
  /// userId người bấm gửi — null với tin nhắn "in" (khách gửi tới, không ai trong hệ thống
  /// là người gửi) hoặc tin nhắn "out" gửi qua kênh khác ngoài app (hiếm, dự phòng).
  sentByUserId         String?
  readAt               DateTime?
  createdAt            DateTime  @default(now())

  @@index([counterpartNumber, createdAt])
  @@map("sms_messages")
}
