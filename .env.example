# Copy file này thành .env.local (dev) hoặc cấu hình tương ứng trên Vercel (production)
# — không commit giá trị thật vào git.

# Connection string Postgres. Dev: Docker local (xem docker-compose.yml). Production:
# lấy từ Neon/Supabase (khuyến nghị dùng "pooled connection" cho môi trường serverless).
DATABASE_URL="postgresql://directfunder:directfunder@localhost:5432/directfunder?schema=public"

# Secret ký JWT session (xem src/lib/auth.ts). Sinh 1 chuỗi ngẫu nhiên riêng cho mỗi môi
# trường, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KHÔNG dùng chung secret giữa local và production.
AUTH_SECRET="change-me"

# Gmail App Password để gửi email CPA qua SMTP (nút "Send mail to CPA") — tạo tại
# myaccount.google.com/apppasswords (yêu cầu bật xác minh 2 bước/2FA trên tài khoản
# Gmail dùng để gửi). KHÔNG phải mật khẩu Google thường. Dùng chung 1 tài khoản Gmail
# công ty cho mọi lần gửi — không dùng tài khoản cá nhân.
GMAIL_USER="company@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Tên hiển thị cho tài khoản gửi (dùng ở "From" trong mail lẫn biến {senderName} trong
# mẫu email CPA) — tùy chọn, nếu bỏ trống thì "From"/{senderName} hiện đúng GMAIL_USER.
GMAIL_SENDER_NAME="Direct Funder"

# Google OAuth2 Client (Google Cloud Console → APIs & Services → Credentials) — dùng cho
# nút "Send" đẩy dòng dữ liệu hồ sơ lên Google Sheet (cột Status, chỉ hiện khi trạng thái
# là "Kế toán duyệt"). Auth OAuth2 THEO TỪNG USER (mỗi Processor/Manager tự đăng nhập
# Google 1 lần), không phải 1 service account chung. Redirect URI cần đăng ký (tự build từ
# request origin, không cần thêm biến môi trường riêng cho URL):
#   http://localhost:3000/api/auth/google/callback (dev)
#   https://<production-domain>/api/auth/google/callback (prod)
# Scope cần bật khi tạo OAuth consent screen: https://www.googleapis.com/auth/spreadsheets
# (sensitive scope — để app ở trạng thái "Testing" + thêm từng Processor/Manager thật làm
# Test user là đủ dùng cho quy mô team nhỏ, KHÔNG cần Google verify app).
GOOGLE_OAUTH_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="xxx"

# Google Sheets API qua SERVICE ACCOUNT (khác OAuth2 theo user ở trên) — dùng cho đồng bộ
# 2 chiều "CPA Review" (bảng Hồ sơ <-> 1 Sheet chung theo tháng, xem
# deployment-database-sync.md mục 4.22) — phải tự ghi được khi BẤT KỲ Agent/Processor nào
# sửa hồ sơ, không phụ thuộc ai đã kết nối Google cá nhân. Tạo Service Account trên Google
# Cloud Console (bật Sheets API), tải JSON key, share quyền Editor Sheet đích cho đúng
# client_email đó. Thiếu email + (1 trong 2 dạng key bên dưới) -> tính năng tự tắt
# (no-op), KHÔNG crash app.
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxx@xxx.iam.gserviceaccount.com"
# Dán PRIVATE KEY qua ô nhập text của Vercel (hay bất kỳ nơi lưu env var nào) rất dễ bị
# lệch định dạng (quote dính vào giá trị, \n literal bị trình duyệt đổi thành newline thật
# hoặc ngược lại) — ĐÃ GẶP THẬT 2026-08-15, dán lại nhiều lần vẫn lỗi "Không xác thực được
# Service Account". KHUYẾN NGHỊ dùng _BASE64 thay vì bản PEM thô — base64 chỉ 1 dòng, toàn
# ký tự an toàn, không có gì để bị mangle qua textarea:
#   node -e "console.log(Buffer.from(require('./key.json').private_key).toString('base64'))"
# (key.json là file JSON Service Account tải từ Google Cloud Console). App ưu tiên đọc
# _BASE64 nếu có, chỉ dùng bản PEM thô làm dự phòng.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY_BASE64="xxx (base64 của field private_key trong key.json)"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n"

# SMTP webmail công ty (mail.directfunder.com, cPanel) — dùng cho nút "Gửi email cho khách
# hàng" trong popup Edit Hồ sơ (cạnh ô Email). Thay cho Microsoft Graph OAuth2 cũ (gỡ bỏ
# 2026-08-15 — không có quyền admin Azure AD của tenant để tạo App registration, xem
# .claude/rules/deployment-database-sync.md). MỖI USER tự kết nối mailbox webmail RIÊNG
# của mình (email + mật khẩu webmail thật, nhập qua dialog trong app — không phải OAuth
# popup), lưu mã hóa ở User.webmailUsername/webmailPasswordEncrypted — không phải 1 mailbox
# chung như GMAIL_USER ở trên.
# Host/port có thể bỏ trống — code tự dùng mặc định mail.directfunder.com:465 (SSL) khi
# thiếu 2 biến này, chỉ cần set nếu công ty đổi sang mail server khác.
WEBMAIL_SMTP_HOST="mail.directfunder.com"
WEBMAIL_SMTP_PORT="465"
# Key mã hóa mật khẩu webmail lưu trong DB (AES-256-GCM, xem src/lib/webmail-crypto.ts) —
# BẮT BUỘC phải set, sinh bằng: openssl rand -base64 32 (hoặc
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). KHÔNG
# ĐƯỢC đổi giá trị này sau khi đã có user kết nối — đổi key sẽ khiến mọi mật khẩu đã lưu
# không giải mã được nữa, buộc toàn bộ user phải kết nối lại.
WEBMAIL_CREDENTIAL_ENCRYPTION_KEY="xxx (base64 của 32 byte ngẫu nhiên)"

# Pusher (dashboard.pusher.com → Channels → tạo app mới) — dùng cho realtime: chuông thông
# báo (giao việc/hồ sơ) và bảng Hồ sơ/Order tự cập nhật khi người khác sửa, không cần
# reload trang. Thiếu các biến này app vẫn chạy bình thường, chỉ mất phần realtime (xem
# src/lib/pusher-server.ts/pusher-client.ts — tự no-op nếu thiếu env, không crash).
# Server (bí mật, KHÔNG lộ ra client):
PUSHER_APP_ID="xxxxxx"
PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
PUSHER_SECRET="xxxxxxxxxxxxxxxxxxxx"
PUSHER_CLUSTER="ap1"
# Client (NEXT_PUBLIC_* nên lộ ra browser là bình thường — key public, không phải secret):
NEXT_PUBLIC_PUSHER_KEY="xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PUSHER_CLUSTER="ap1"

# RingCentral (nhắn/nhận SMS theo hồ sơ, nút icon dưới "Send Data" — xem src/lib/ringcentral.ts)
# — JWT server-to-server, dùng CHUNG 1 số điện thoại công ty cho MỌI user (khác OAuth2 theo
# từng user như webmail). Tạo App (REST API App, JWT auth flow) trên
# developers.ringcentral.com/my-account.html#/applications, tick quyền SMS/ReadMessages/
# Webhook Subscriptions, lấy Client ID/Secret ngay trên dashboard app; tạo JWT credential qua
# (hover tên tài khoản góc trên phải) -> Credentials -> Create JWT, restrict theo app vừa tạo.
RINGCENTRAL_CLIENT_ID="xxx"
RINGCENTRAL_CLIENT_SECRET="xxx"
RINGCENTRAL_JWT="xxx"
# Số điện thoại RingCentral công ty dùng để gửi SMS, định dạng E.164 (đã bật SMS trong gói).
RINGCENTRAL_SMS_FROM_NUMBER="+1xxxxxxxxxx"
# Bỏ trống dùng mặc định https://platform.ringcentral.com — chỉ đổi nếu dùng sandbox riêng.
RINGCENTRAL_SERVER_URL="https://platform.ringcentral.com"

# Bí mật xác thực Vercel Cron (xem vercel.json + src/app/api/cron/ringcentral-renew) — tự
# gia hạn subscription webhook nhận SMS mỗi ngày (subscription RingCentral hết hạn ~7 ngày).
# Vercel TỰ ĐỘNG đính header "Authorization: Bearer $CRON_SECRET" cho mọi request cron thật
# khi biến này đã được set trên project — route so khớp để chặn ai đó gọi endpoint tuỳ ý.
# Sinh 1 chuỗi ngẫu nhiên riêng cho mỗi môi trường: openssl rand -hex 24 (hoặc
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"). Không bắt buộc
# ở local (thiếu thì route tự trả 401, không crash) — chỉ cần set trên Vercel Production.
CRON_SECRET="xxx"

# Vercel Blob (Storage → Create Blob Store → Connect Project trên Vercel Dashboard, KHÔNG
# làm được từ code — cần thao tác tay 1 lần) — dùng để client upload PDF THẲNG lên Blob
# storage (né giới hạn CỨNG ~4.5MB thân request của Vercel Serverless Function) cho tab
# "Notice Splitter" (xem src/app/api/irs-splitter/blob-upload). Vercel TỰ ĐỘNG bơm biến này
# vào Environment Variables production khi đã connect Blob Store cho project — không cần tự
# thêm tay trên Vercel. Local dev cần biến này để test: `vercel env pull .env.local` (sau khi
# đã link project qua `vercel link`) hoặc copy tay từ Dashboard → Storage → Blob Store →
# .env.local tab. Thiếu biến này thì upload/xoá blob sẽ lỗi rõ ràng, không crash ngầm.
BLOB_READ_WRITE_TOKEN="xxx"

# MCP server CHỈ ĐỌC (mcp-server/index.ts, `npm run mcp`) — chạy LOCAL, kết nối bằng Claude
# Desktop/Claude Code qua stdio, KHÔNG deploy/không cần biến này trên Vercel. Tự đăng nhập
# bằng CHÍNH tài khoản Direct Funder thật (email/username + password) rồi gọi lại API sẵn
# có, dữ liệu trả về đã lọc RBAC đúng role tài khoản đó — không có API key/token riêng nào
# khác. Xem mcp-server/README.md để cấu hình Claude Desktop.
MCP_APP_BASE_URL="http://localhost:3000"
MCP_LOGIN_EMAIL="ten@directfunder.com"
MCP_LOGIN_PASSWORD="12345678"

# CRM ngoài agentc3 (tax.agentc3.com, PHP/CodeIgniter cũ, KHÔNG liên quan database/app Direct
# Funder) — dùng CHUNG 1 tài khoản cho MỌI user Direct Funder gọi tính năng "Nhập từ CRM" (nút
# toolbar bảng Hồ sơ, xem src/lib/agentc3-client.ts + POST /api/agentc3-import/fetch). Thiếu
# biến này thì route tự trả lỗi rõ ràng 501 "Chưa cấu hình...", không crash app.
AGENTC3_USERNAME="xxx"
AGENTC3_PASSWORD="xxx"

# Google Cloud Translation API v2 — dùng cho nút "Dịch" trên header (Languages icon, cạnh
# chuông thông báo, xem src/lib/google-translate.ts + POST /api/translate) — dịch văn bản tự
# do người dùng gõ/dán, không gắn với hồ sơ nào. Xác thực bằng API KEY đơn giản (KHÁC Service
# Account đang dùng cho Google Sheets sync ở trên) — tạo tại Google Cloud Console → APIs &
# Services → Credentials → Create API Key, nhớ bật "Cloud Translation API" cho project đó
# (Enable APIs & Services → tìm "Cloud Translation API" → Enable, có gói miễn phí 500,000 ký
# tự/tháng). Nên giới hạn API key theo "Cloud Translation API" (API restrictions) để tránh bị
# dùng sai mục đích nếu lộ. Thiếu biến này thì route tự trả lỗi rõ ràng 501, không crash app.
GOOGLE_TRANSLATE_API_KEY="xxx"
