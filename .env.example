# Copy file này thành .env.local (dev) hoặc cấu hình tương ứng trên Vercel (production)
# — không commit giá trị thật vào git.

# Connection string Postgres. Dev: Docker local (xem docker-compose.yml). Production:
# lấy từ Neon/Supabase (khuyến nghị dùng "pooled connection" cho môi trường serverless).
DATABASE_URL="postgresql://directfunder:directfunder@localhost:5432/directfunder?schema=public"

# Secret ký JWT session (xem src/lib/auth.ts). Sinh 1 chuỗi ngẫu nhiên riêng cho mỗi môi
# trường, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KHÔNG dùng chung secret giữa local và production.
AUTH_SECRET="change-me"

# Gmail App Password để gửi email CPA qua SMTP (nút "Send mail to CPA") — tạo tại
# myaccount.google.com/apppasswords (yêu cầu bật xác minh 2 bước/2FA trên tài khoản
# Gmail dùng để gửi). KHÔNG phải mật khẩu Google thường. Dùng chung 1 tài khoản Gmail
# công ty cho mọi lần gửi — không dùng tài khoản cá nhân.
GMAIL_USER="company@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Tên hiển thị cho tài khoản gửi (dùng ở "From" trong mail lẫn biến {senderName} trong
# mẫu email CPA) — tùy chọn, nếu bỏ trống thì "From"/{senderName} hiện đúng GMAIL_USER.
GMAIL_SENDER_NAME="Direct Funder"

# Google OAuth2 Client (Google Cloud Console → APIs & Services → Credentials) — dùng cho
# nút "Send" đẩy dòng dữ liệu hồ sơ lên Google Sheet (cột Status, chỉ hiện khi trạng thái
# là "Kế toán duyệt"). Auth OAuth2 THEO TỪNG USER (mỗi Processor/Manager tự đăng nhập
# Google 1 lần), không phải 1 service account chung. Redirect URI cần đăng ký (tự build từ
# request origin, không cần thêm biến môi trường riêng cho URL):
#   http://localhost:3000/api/auth/google/callback (dev)
#   https://<production-domain>/api/auth/google/callback (prod)
# Scope cần bật khi tạo OAuth consent screen: https://www.googleapis.com/auth/spreadsheets
# (sensitive scope — để app ở trạng thái "Testing" + thêm từng Processor/Manager thật làm
# Test user là đủ dùng cho quy mô team nhỏ, KHÔNG cần Google verify app).
GOOGLE_OAUTH_CLIENT_ID="xxx.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="xxx"
